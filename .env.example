# Shopify Store Credentials (Keep your .env private and never commit it)
# Store domain (e.g., your-store-name.myshopify.com)
SHOPIFY_SHOP_DOMAIN=your-store-name.myshopify.com

# Shopify Admin API Access Token (Starts with shpat_...)
# Created via Shopify Admin -> Settings -> Apps and sales channels -> Develop apps
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Version (Shopify uses YYYY-MM releases, e.g., 2026-01 or 2025-10)
SHOPIFY_API_VERSION=2026-01

# Optional: Storefront API Access Token (For public headless querying / testing)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
