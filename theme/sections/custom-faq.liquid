{% style %}
  .faq-section {
    padding: 5rem 0;
    position: relative;
  }

  .faq-header {
    max-width: 680px;
    margin: 0 auto 3rem auto;
    text-align: center;
  }

  .faq-tag {
    display: inline-block;
    background: rgba(89, 53, 154, 0.1);
    color: #59359a;
    font-weight: 700;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.4rem 1.2rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .faq-title {
    font-size: clamp(2.6rem, 3.5vw, 3.8rem);
    font-weight: 800;
    color: #1e1b4b;
    line-height: 1.2;
    margin-bottom: 0.8rem;
    letter-spacing: -0.02em;
  }

  .faq-subtitle {
    font-size: 1.5rem;
    color: #6b7280;
    margin-bottom: 2rem;
  }

  .faq-accordion-container {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .glass-faq-card {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 18px;
    padding: 1.6rem 2rem;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .glass-faq-card[open] {
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 10px 30px rgba(89, 53, 154, 0.1);
    border-color: rgba(89, 53, 154, 0.25);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.65rem;
    font-weight: 700;
    color: #1e1b4b;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    font-size: 2.2rem;
    font-weight: 400;
    color: #59359a;
    transition: transform 0.3s ease;
    line-height: 1;
  }

  .glass-faq-card[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    margin-top: 1.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(89, 53, 154, 0.08);
    font-size: 1.45rem;
    line-height: 1.6;
    color: #4b5563;
  }

  .faq-answer p {
    margin: 0;
  }
{% endstyle %}

<div class="faq-section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="faq-header text-center">
      <span class="faq-tag">Frequently Asked Questions</span>
      <h2 class="faq-title">Got Questions? We've Got Answers.</h2>
      <p class="faq-subtitle">Everything you need to know about our peroxide-free whitening science and daily oral routine.</p>
    </div>

    <div class="faq-accordion-container">
      <details class="faq-item glass-faq-card" open>
        <summary class="faq-question">
          <span>How quickly will I notice whiter teeth?</span>
          <span class="faq-icon">+</span>
        </summary>
        <div class="faq-answer">
          <p>Most customers notice an immediate 1 to 2 shade brightening after their first use due to our instant purple color-correction technology. Completing the full 7-day treatment delivers up to 4 shades whiter teeth with long-lasting results.</p>
        </div>
      </details>

      <details class="faq-item glass-faq-card">
        <summary class="faq-question">
          <span>Will Perfora cause any tooth or gum sensitivity?</span>
          <span class="faq-icon">+</span>
        </summary>
        <div class="faq-answer">
          <p>Zero sensitivity guaranteed! Traditional whitening products use harsh hydrogen peroxide that dehydrates teeth and burns dentin. Perfora uses biocompatible Hydroxyapatite (n-Ha) and PAP to actively strengthen enamel while lifting organic surface stains.</p>
        </div>
      </details>

      <details class="faq-item glass-faq-card">
        <summary class="faq-question">
          <span>How do I use the Purple Whitening Strips?</span>
          <span class="faq-icon">+</span>
        </summary>
        <div class="faq-answer">
          <p>Dry your teeth with a tissue, peel the universal strip from its backing, and press it firmly onto your upper or lower teeth. Keep it on for 30 minutes. The strip naturally dissolves on its own with a clean minty freshness—no sticky residue or rinsing required!</p>
        </div>
      </details>

      <details class="faq-item glass-faq-card">
        <summary class="faq-question">
          <span>Is it safe for crowns, veneers, caps, and fillings?</span>
          <span class="faq-icon">+</span>
        </summary>
        <div class="faq-answer">
          <p>Yes. Our non-abrasive, SLS-free formulations are 100% safe for artificial dental work. While it will not bleach crowns past their initial manufactured shade, it safely lifts accumulated tea, coffee, and food stains to restore their original brightness.</p>
        </div>
      </details>

      <details class="faq-item glass-faq-card">
        <summary class="faq-question">
          <span>What are your shipping times and delivery charges?</span>
          <span class="faq-icon">+</span>
        </summary>
        <div class="faq-answer">
          <p>We provide Free Express Delivery across India on all orders. Orders are processed within 24 hours, and standard transit takes 2-4 business days for metro locations and 3-5 days for other regions. Cash on Delivery (COD) and instant UPI are both supported.</p>
        </div>
      </details>

      <details class="faq-item glass-faq-card">
        <summary class="faq-question">
          <span>How do I contact Customer Care?</span>
          <span class="faq-icon">+</span>
        </summary>
        <div class="faq-answer">
          <p>Our dedicated customer care helpline is <strong><a href="tel:7780938743" style="color: #59359a; font-weight: 700;">7780938743</a></strong> (Monday to Saturday, 10 AM to 7 PM IST). You can call or WhatsApp us anytime for fast order tracking and questions.</p>
        </div>
      </details>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom FAQ Accordion",
  "tag": "section",
  "class": "section-custom-faq",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Custom FAQ Accordion"
    }
  ]
}
{% endschema %}
