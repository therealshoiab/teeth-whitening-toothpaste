      {%- for review_str in reviews_data -%}
        {%- assign r_parts = review_str | split: "|" -%}
        {%- if r_parts.size >= 4 -%}
          {%- assign img_filename = r_parts[5] | default: 'none' | strip -%}
          {%- assign has_photo = false -%}
          {%- if img_filename != blank and img_filename != 'none' -%}
            {%- assign has_photo = true -%}
          {%- endif -%}
          <div class="review-card glass-review-card{% unless has_photo %} review-card--text-only{% endunless %}">
            <div class="review-card-top">
              <div class="reviewer-info">
                <div class="reviewer-avatar">{{ r_parts[0] | slice: 0, 1 | strip }}</div>
                <div>
                  <h4 class="reviewer-name">{{ r_parts[0] | strip }}</h4>
                  <span class="verified-badge">✓ {{ r_parts[4] | default: 'Verified Buyer' | strip }}</span>
                </div>
              </div>
              <div class="review-stars">{{ r_parts[2] | strip }}</div>
            </div>
            
            {%- if has_photo -%}
              <div
                class="review-customer-image-wrap js-review-modal-trigger"
                data-img-src="{{ img_filename | asset_url }}"
                data-author="{{ r_parts[0] | strip | escape }}"
                data-product="{{ r_parts[1] | strip | escape }}"
                data-review="{{ r_parts[3] | strip | escape }}"
              >
                <img
                  src="{{ img_filename | asset_url }}"
                  alt="{{ r_parts[0] | strip }} holding {{ r_parts[1] | strip }}"
                  loading="lazy"
                  width="400"
                  height="500"
                  class="review-customer-image"
                >
                <span class="customer-photo-badge">📷 Customer Photo</span>
              </div>
            {%- endif -%}

            <div class="review-product-tag">Product: {{ r_parts[1] | strip }}</div>
            <p class="review-text">"{{ r_parts[3] | strip }}"</p>
          </div>
        {%- endif -%}
