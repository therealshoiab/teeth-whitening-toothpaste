{% style %}
  .reviews-section {
    padding: 5rem 0;
    position: relative;
  }

  .reviews-header {
    max-width: 700px;
    margin: 0 auto 3.5rem auto;
    text-align: center;
  }

  .reviews-tag {
    display: inline-block;
    background: rgba(16, 185, 129, 0.12);
    color: #059669;
    font-weight: 700;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.4rem 1.2rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .reviews-title {
    font-size: clamp(2.6rem, 3.5vw, 3.8rem);
    font-weight: 800;
    color: #1e1b4b;
    line-height: 1.2;
    margin-bottom: 0.8rem;
    letter-spacing: -0.02em;
  }

  .reviews-subtitle {
    font-size: 1.5rem;
    color: #6b7280;
    margin-bottom: 2rem;
  }

  .glass-score-card {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 24px;
    padding: 1.8rem 2rem;
    box-shadow: 0 10px 30px rgba(89, 53, 154, 0.08);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .score-stars {
    color: #f59e0b;
    font-size: 2.2rem;
    letter-spacing: 2px;
  }

  .score-number {
    font-size: 2.8rem;
    font-weight: 800;
    color: #1e1b4b;
    line-height: 1;
  }

  .score-count {
    font-size: 1.3rem;
    color: #6b7280;
    font-weight: 500;
  }

  .score-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.8rem;
  }

  .trust-pill {
    background: rgba(89, 53, 154, 0.08);
    color: #59359a;
    font-size: 1.15rem;
    font-weight: 600;
    padding: 0.3rem 0.8rem;
    border-radius: 9999px;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.8rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }

  @media screen and (max-width: 749px) {
    .reviews-grid {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }
  }

  .glass-review-card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 20px;
    padding: 1.8rem;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }

  
    .review-card--text-only {
    justify-content: flex-start;
    height: fit-content;
    align-self: start;
  }

  .review-card--text-only .review-product-tag {
    margin-top: 0.4rem;
    margin-bottom: 1rem;
  }

  .review-card--text-only .review-text {
    font-size: 1.45rem;
    line-height: 1.6;
    color: #1f2937;
  }

  .glass-review-card:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 12px 30px rgba(89, 53, 154, 0.12);
    border-color: rgba(89, 53, 154, 0.25);
  }

  .review-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .reviewer-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .reviewer-avatar {
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, #6b3ba6, #4c2882);
    color: #ffffff;
    font-weight: 700;
    font-size: 1.4rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .reviewer-name {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 700;
    color: #1e1b4b;
  }

  .verified-badge {
    font-size: 1.1rem;
    color: #059669;
    font-weight: 600;
  }

  .review-stars {
    color: #f59e0b;
    font-size: 1.6rem;
    letter-spacing: 1px;
  }

  .review-product-tag {
    font-size: 1.2rem;
    color: #59359a;
    font-weight: 600;
    background: rgba(89, 53, 154, 0.06);
    padding: 0.3rem 0.8rem;
    border-radius: 6px;
    display: inline-block;
    align-self: flex-start;
    margin-bottom: 1rem;
  }

  .review-customer-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 1.2rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    background: #0f0724;
    cursor: pointer;
  }

  .review-customer-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    transition: transform 0.35s ease;
    image-rendering: -webkit-optimize-contrast;
  }

  .review-customer-image-wrap:hover .review-customer-image {
    transform: scale(1.03);
  }

  .customer-photo-badge {
    position: absolute;
    bottom: 8px;
    left: 8px;
    background: rgba(16, 7, 34, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    letter-spacing: 0.02em;
  }

  .review-text {
    font-size: 1.35rem;
    line-height: 1.5;
    color: #374151;
    margin: 0;
    font-style: italic;
  }

  .review-card-hidden {
    display: none !important;
  }

  .reviews-action button {
    padding: 1.2rem 2.8rem;
    font-size: 1.4rem;
  }

  /* Lightbox Modal for Full UGC View */
  .review-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(10, 4, 24, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
  }

  .review-modal-content {
    position: relative;
    max-width: 440px;
    width: 90vw;
    max-height: 90vh;
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.45);
    animation: modalPop 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }

  @keyframes modalPop {
    from { opacity: 0; transform: scale(0.92); }
    to { opacity: 1; transform: scale(1); }
  }

  .review-modal-img-wrap {
    background: #0d061f;
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: 56vh;
    overflow: hidden;
    position: relative;
  }

  .review-modal-img {
    width: 100%;
    max-height: 56vh;
    object-fit: contain;
    display: block;
    margin: 0 auto;
    image-rendering: -webkit-optimize-contrast;
  }

  .review-modal-details {
    padding: 1.6rem 2rem;
    overflow-y: auto;
  }

  .review-modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    background: rgba(0, 0, 0, 0.6);
    color: #ffffff;
    border: none;
    border-radius: 50%;
    font-size: 2.2rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    z-index: 10;
  }

  .review-modal-close:hover {
    background: rgba(0, 0, 0, 0.9);
  }
{% endstyle %}

