<!-- Lightbox Modal -->
<div id="reviewPhotoModal" class="review-modal" style="display: none;" onclick="closeReviewModal(event)">
  <div class="review-modal-content" onclick="event.stopPropagation()">
    <button type="button" class="review-modal-close" onclick="closeReviewModal(event)">&times;</button>
    <div class="review-modal-img-wrap">
      <img id="reviewModalImg" src="{{ 'ugc_review_1.jpg' | asset_url }}" alt="Customer Review Photo" width="600" height="950" class="review-modal-img">
    </div>
    <div class="review-modal-details">
      <div id="reviewModalProduct" class="review-product-tag" style="margin-bottom: 0.6rem;"></div>
      <h4 id="reviewModalAuthor" class="reviewer-name" style="margin-bottom: 0.8rem;"></h4>
      <p id="reviewModalText" class="review-text"></p>
    </div>
  </div>
</div>

<script>
  function openReviewModal(imgSrc, author, product, text) {
    const modal = document.getElementById('reviewPhotoModal');
    if (!modal) return;
    const modalImg = document.getElementById('reviewModalImg');
    if (modalImg) modalImg.src = imgSrc;
    const prodEl = document.getElementById('reviewModalProduct');
    if (prodEl) prodEl.textContent = 'Product: ' + product;
    const authorEl = document.getElementById('reviewModalAuthor');
    if (authorEl) authorEl.textContent = author + ' (Verified Buyer)';
    const textEl = document.getElementById('reviewModalText');
    if (textEl) textEl.textContent = '“' + text + '”';
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeReviewModal(e) {
    const modal = document.getElementById('reviewPhotoModal');
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    // Attach click listeners to all review cards using data attributes
    document.querySelectorAll('.js-review-modal-trigger').forEach(function(trigger) {
      trigger.addEventListener('click', function() {
        const imgSrc = this.getAttribute('data-img-src');
        const author = this.getAttribute('data-author');
        const product = this.getAttribute('data-product');
        const text = this.getAttribute('data-review');
        openReviewModal(imgSrc, author, product, text);
      });
    });

    const btn = document.getElementById('LoadMoreReviewsBtn');
    const grid = document.getElementById('PerforaReviewsGrid');
    if (btn && grid) {
      const cards = grid.querySelectorAll('.review-card');
      // Initially show first 6 on mobile, 9 on desktop
      const initialCount = window.innerWidth < 750 ? 6 : 9;
      cards.forEach((card, idx) => {
        if (idx >= initialCount) {
          card.classList.add('review-card-hidden');
        }
      });
      btn.addEventListener('click', function() {
        const isExpanded = btn.getAttribute('data-expanded') === 'true';
        if (isExpanded) {
          cards.forEach((card, idx) => {
            if (idx >= initialCount) card.classList.add('review-card-hidden');
          });
          btn.textContent = 'Show All 47 Reviews';
          btn.setAttribute('data-expanded', 'false');
          grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          cards.forEach(card => card.classList.remove('review-card-hidden'));
          btn.textContent = 'Show Less';
          btn.setAttribute('data-expanded', 'true');
        }
      });
    }
  });
</script>

