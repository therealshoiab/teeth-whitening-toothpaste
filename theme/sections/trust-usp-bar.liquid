{% style %}
  .trust-usp-bar-section {
    padding: 1.5rem 0 2rem 0;
    position: relative;
    z-index: 5;
    margin-top: -1.5rem;
  }

  .trust-usp-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
  }

  @media screen and (max-width: 989px) {
    .trust-usp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 550px) {
    .trust-usp-grid {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
  }

  .glass-usp-card {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.95);
    border-radius: 16px;
    padding: 1rem 1.4rem;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    box-shadow: 0 8px 24px rgba(89, 53, 154, 0.06);
    transition: all 0.25s ease;
  }

  .glass-usp-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(89, 53, 154, 0.12);
    border-color: rgba(89, 53, 154, 0.3);
  }

  .usp-icon-wrap {
    width: 46px;
    height: 46px;
    min-width: 46px;
    border-radius: 12px;
    background: rgba(89, 53, 154, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }

  .glass-usp-card:hover .usp-icon-wrap {
    background: #59359a;
    transform: scale(1.06);
  }

  .usp-icon-wrap svg {
    stroke: #59359a;
    transition: stroke 0.25s ease;
  }

  .glass-usp-card:hover .usp-icon-wrap svg {
    stroke: #ffffff;
  }

  .usp-content h4 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
    color: #1e1b4b;
  }

  .usp-content p {
    margin: 0.2rem 0 0 0;
    font-size: 1.2rem;
    color: #6b7280;
  }
{% endstyle %}

<div class="trust-usp-bar-section">
  <div class="page-width">
    <div class="trust-usp-grid">
      <div class="trust-usp-item glass-usp-card">
        <div class="usp-icon-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13" rx="2"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <div class="usp-content">
          <h4>Free Shipping</h4>
          <p>On all orders across India</p>
        </div>
      </div>

      <div class="trust-usp-item glass-usp-card">
        <div class="usp-icon-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
        </div>
        <div class="usp-content">
          <h4>100% Enamel-Safe</h4>
          <p>Zero sensitivity guaranteed</p>
        </div>
      </div>

      <div class="trust-usp-item glass-usp-card">
        <div class="usp-icon-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
          </svg>
        </div>
        <div class="usp-content">
          <h4>Clean & Toxic-Free</h4>
          <p>Peroxide, SLS & paraben free</p>
        </div>
      </div>

      <div class="trust-usp-item glass-usp-card">
        <div class="usp-icon-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            <circle cx="12" cy="16" r="1"></circle>
          </svg>
        </div>
        <div class="usp-content">
          <h4>Secure UPI & COD</h4>
          <p>Safe encrypted checkout</p>
        </div>
      </div>
    </div>
  </div>
</div>

